# Documentation only: the application reads process environment variables.
# It does not load .env automatically. Never commit actual credentials.
AGENT_DEMO_ENV=development
AGENT_DEMO_LOG_LEVEL=INFO
GEMINI_MODEL=gemini-3.5-flash-lite
# Set GEMINI_API_KEY securely in the process environment for live Phase 1 runs.
# GOOGLE_API_KEY is accepted as a fallback when GEMINI_API_KEY is absent.
